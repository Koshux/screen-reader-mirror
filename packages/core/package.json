{
  "name": "screen-reader-mirror",
  "version": "0.3.1",
  "description": "See what a screen reader interprets from your UI: a zero-install, client-side engine that turns the accessibility tree into screen-reader reading order (roles, accessible names, heading levels) and flags the common mistakes. No data leaves the machine.",
  "license": "MIT",
  "author": "James Lanzon",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "web-accessibility",
    "accessibility-testing",
    "a11y-testing",
    "screen reader",
    "screen-reader",
    "screen-reader-testing",
    "reading-order",
    "accessibility-tree",
    "ax-tree",
    "aria",
    "wai-aria",
    "accname",
    "accessible-name",
    "wcag",
    "nvda",
    "jaws",
    "voiceover",
    "assistive-technology",
    "semantic-html",
    "devtools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Koshux/screen-reader-mirror.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Koshux/screen-reader-mirror#readme",
  "bugs": {
    "url": "https://github.com/Koshux/screen-reader-mirror/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/aria-query": "^5.0.4",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "aria-query": "^5.3.2",
    "dom-accessibility-api": "^0.7.1"
  }
}
