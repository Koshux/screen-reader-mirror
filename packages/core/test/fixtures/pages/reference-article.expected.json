    "role": "figure",
    "name": "",
    "ref": {
      "tag": "figure"
    }
  },
  {
    "role": "img",
    "name": "Three boxes in a row with equal space between them",
    "ref": {
      "tag": "img"
    }
  },
  {
    "role": "text",
    "name": "Gaps apply between items, never on the outer edges."
  },
