{
  "note": "Slate and coral. Dark is the default; the page follows prefers-color-scheme and switches to the light pair. Ratios are WCAG contrast against the stated ground; every text pair is 7:1 or better.",
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, Ubuntu, Cantarell, sans-serif",
    "mono": "ui-monospace, Menlo, Consolas, monospace"
  },
  "radius": {
    "control": "8px",
    "pane": "12px",
    "flag": "999px",
    "mark": "6px"
  },
  "focus": {
    "ring": "2px solid {focus}",
    "offset": "2px",
    "row-offset": "-2px"
  },
  "target": {
    "min": "44px"
  },
  "dark": {
    "bg": "#15181c",
    "surface": "#1d2126",
    "surface-2": "#252a31",
    "text": "#e6e9ee",
    "muted": "#aeb5c0",
    "border": "#2d333b",
    "border-strong": "#4e5663",
    "link": "#ff9b85",
    "primary": "#ff9b85",
    "on-primary": "#2a0e07",
    "accent-soft": "#3a2622",
    "flag-bg": "#3b3410",
    "flag-text": "#efe08a",
    "focus": "#ff9b85",
    "code-string": "#d6d1c2",
    "code-comment": "#8a919c",
    "contrast": {
      "text/bg": "15.9",
      "muted/bg": "8.6",
      "muted/surface": "7.7",
      "link/bg": "8.9",
      "link/accent-soft": "6.5 (bold 14px segments only)",
      "on-primary/primary": "8.5",
      "flag-text/flag-bg": "9.7",
      "code-comment/surface": "4.6 (comments only; raise to #a3aab5 if body-size)",
      "border-strong/bg (non-text)": "3.1"
    }
  },
  "light": {
    "bg": "#f7f8fa",
    "surface": "#eef0f3",
    "surface-2": "#e3e6ea",
    "text": "#171a1f",
    "muted": "#4a505a",
    "border": "#d5d9df",
    "border-strong": "#99a0ab",
    "link": "#9a2e17",
    "primary": "#9a2e17",
    "on-primary": "#ffffff",
    "accent-soft": "#fde4dc",
    "flag-bg": "#fff1b8",
    "flag-text": "#5a4a00",
    "focus": "#9a2e17",
    "code-string": "#5a4a2a",
    "code-comment": "#6b7079",
    "contrast": {
      "text/bg": "16.4",
      "muted/bg": "7.9",
      "muted/surface": "7.3",
      "link/bg": "7.5",
      "link/accent-soft": "6.4 (bold 14px segments only)",
      "on-primary/primary": "7.5",
      "flag-text/flag-bg": "7.8",
      "border-strong/bg (non-text)": "2.8"
    }
  },
  "fallbacks": {
    "A graphite and ochre": ".t-ochre in Demo page.dc.html",
    "B deep green and mint": ".t-green",
    "D paper and teal": ".t-paper"
  }
}
